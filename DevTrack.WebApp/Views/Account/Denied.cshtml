@{
    ViewData["Title"] = "Access Denied";
}

<div class="min-h-[calc(100vh-14rem)] flex items-center justify-center animate-in">
    <div class="w-full max-w-lg bg-white border border-slate-200 shadow-xl shadow-slate-200/60 rounded-2xl p-8 text-center">
        <p class="text-sm font-semibold text-primary uppercase tracking-widest">Access Denied</p>
        <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-slate-900">You cannot access this page.</h1>
        <p class="mt-3 text-sm text-slate-500">Sign in with an administrator account to continue.</p>
        <a asp-controller="Account" asp-action="Login"
           class="mt-8 inline-flex items-center justify-center rounded-xl bg-primary px-5 py-3 text-sm font-bold text-white shadow-lg shadow-primary/20 transition hover:bg-primary/90">
            Back to Login
        </a>
    </div>
</div>
